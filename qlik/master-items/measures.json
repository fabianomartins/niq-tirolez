      "expression": "If(Sum(RealPositivacao) > 0, Sum(RealMixHero) / Sum(RealPositivacao), 0)",
      "format": {
        "type": "F",
        "fmt": "#.##0,0%",
        "nDec": 1
      },
      "tags": [
        "ppt",
        "hero",
        "qualidade"
      ]
    },
    {
