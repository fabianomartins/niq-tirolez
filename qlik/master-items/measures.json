{
  "_doc": "Medidas mestre do PPT Tirolez. Fonte da verdade: este arquivo. Nunca editar direto na UI de producao - use qlik/tools/deploy-master-items.mjs.",
  "_convencoes": {
    "oficial_vs_dinamica": "Medidas OFICIAIS leem FACT_PPT_MENSAL (numero apurado, imune a filtro de produto/canal - e o que paga). Medidas DINAMICAS recalculam sobre FACT_SELL_OUT e respondem a qualquer filtro. Card de KPI usa a OFICIAL; analise exploratoria usa a DINAMICA. Misturar as duas na mesma tabela e o erro classico que gera 'o numero nao bate'.",
    "flagVenda": "Toda medida sobre FACT_SELL_OUT usa {<FlagVenda={1}>} para excluir as linhas-esqueleto."
  },
  "measures": [
    {
      "id": "PPT_M_META_POSITIVACAO",
      "title": "Meta Positivação",
      "description": "PDVs que o distribuidor precisa positivar no mês. Fonte: FACT_PPT_MENSAL.",
      "expression": "Sum(MetaPositivacao)",
      "format": {
        "type": "I",
        "fmt": "#.##0",
        "nDec": 0
      },
      "tags": [
        "ppt",
        "meta",
        "positivacao",
        "oficial"
      ]
    },
    {
      "id": "PPT_M_REAL_POSITIVACAO",
      "title": "Positivação Realizada",
      "description": "CNPJs únicos positivados no mês, valor apurado. NÃO reage a filtro de produto — é o número que paga.",
      "expression": "Sum(RealPositivacao)",
      "format": {
        "type": "I",
        "fmt": "#.##0",
        "nDec": 0
      },
      "tags": [
        "ppt",
        "realizado",
        "positivacao",
        "oficial"
      ]
    },
    {
      "id": "PPT_M_REAL_POSITIVACAO_DIN",
      "title": "Positivação (dinâmica)",
      "description": "CNPJs únicos com venda no contexto atual. Reage a filtro de produto, canal e categoria Hero. Use para análise, nunca para conferir premiação.",
      "expression": "Count(DISTINCT {<FlagVenda={1}>} %ChavePDV)",
      "format": {
        "type": "I",
        "fmt": "#.##0",
        "nDec": 0
      },
      "tags": [
        "ppt",
        "realizado",
        "positivacao",
        "dinamica"
      ]
    },
    {
      "id": "PPT_M_ATING_POSITIVACAO",
      "title": "% Atingimento Positivação",
      "description": "Realizado / Meta. Abaixo de 90% não há premiação neste KPI.",
      "expression": "If(Sum(MetaPositivacao) > 0, Sum(RealPositivacao) / Sum(MetaPositivacao), 0)",
      "format": {
        "type": "F",
        "fmt": "#.##0,0%",
        "nDec": 1
      },
      "tags": [
        "ppt",
        "atingimento",
        "positivacao"
      ]
    },
    {
      "id": "PPT_M_META_VOLUME",
      "title": "Meta Volume (ton)",
      "description": "Meta mensal de sell out em toneladas.",
      "expression": "Sum(MetaVolumeTon)",
      "format": {
        "type": "F",
        "fmt": "#.##0,0",
        "nDec": 1
      },
      "tags": [
        "ppt",
        "meta",
        "volume",
        "oficial"
      ]
    },
    {
      "id": "PPT_M_REAL_VOLUME",
      "title": "Volume Realizado (ton)",
      "description": "Sell out em toneladas. Reage a qualquer filtro — volume é aditivo, então oficial e dinâmica coincidem quando não há filtro de produto.",
      "expression": "Sum({<FlagVenda={1}>} VolumeTon)",
      "format": {
        "type": "F",
        "fmt": "#.##0,0",
        "nDec": 1
      },
      "tags": [
        "ppt",
        "realizado",
        "volume"
      ]
    },
    {
      "id": "PPT_M_ATING_VOLUME",
      "title": "% Atingimento Volume",
      "expression": "If(Sum(MetaVolumeTon) > 0, Sum(RealVolumeTon) / Sum(MetaVolumeTon), 0)",
      "description": "Realizado apurado / Meta.",
      "format": {
        "type": "F",
        "fmt": "#.##0,0%",
        "nDec": 1
      },
      "tags": [
        "ppt",
        "atingimento",
        "volume"
      ]
    },
    {
      "id": "PPT_M_META_HERO",
