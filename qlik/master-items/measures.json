      "format": {
        "type": "I",
        "fmt": "#.##0",
        "nDec": 0
      },
      "tags": [
        "ppt",
        "realizado",
        "hero",
        "oficial"
      ]
    },
    {
      "id": "PPT_M_REAL_HERO_DIN",
      "title": "PDVs Mix Hero (dinâmica)",
