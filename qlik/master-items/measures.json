      "format": {
        "type": "I",
        "fmt": "#.##0",
        "nDec": 0
      },
      "tags": [
        "ppt",
        "meta",
        "hero",
        "oficial"
      ]
    },
    {
      "id": "PPT_M_REAL_HERO",
