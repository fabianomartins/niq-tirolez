      "format": {
        "type": "I",
        "fmt": "#.##0",
        "nDec": 0
      },
      "tags": [
        "ppt",
        "realizado",
        "hero",
        "dinamica"
      ]
    },
    {
      "id": "PPT_M_ATING_HERO",
      "title": "% Atingimento Mix Hero",
      "expression": "If(Sum(MetaMixHero) > 0, Sum(RealMixHero) / Sum(MetaMixHero), 0)",
      "format": {
        "type": "F",
        "fmt": "#.##0,0%",
        "nDec": 1
      },
      "tags": [
        "ppt",
        "atingimento",
        "hero"
      ]
    },
    {
      "id": "PPT_M_TAXA_HERO",
