    {
      "id": "PPT_M_DIST_HERO_ABAIXO",
      "title": "Distribuidores com Hero abaixo da meta",
      "expression": "Count(DISTINCT If(AtingMixHero < 0.9, PPT_DistribuidorID))",
      "format": {
        "type": "I",
        "fmt": "#.##0",
        "nDec": 0
      },
      "tags": [
        "executivo",
        "hero",
        "risco"
      ],
      "description": "Distribuidores cujo Mix Hero está abaixo de 90% — a faixa que não paga nada. Usa If() em vez de busca numérica em set analysis: a string \"<0.9\" é reinterpretada pelo número da sessão e, em locale pt-BR, pode não casar. Literal em expressão sempre usa ponto."
    },
