///$tab 04 - Dimensoes
/* =============================================================================
   DIMENSOES DO MODELO ESTRELA
   DIM_REGIAO | DIM_EXECUTIVO | DIM_DISTRIBUIDOR | DIM_PDV | DIM_PRODUTO
   ============================================================================= */

// -----------------------------------------------------------------------------
// DIM_REGIAO
// -----------------------------------------------------------------------------
DIM_REGIAO:
LOAD
    AutoNumberHash128(RegiaoID)  AS %ChaveRegiao,
    RegiaoID,
    RegiaoNome,
    RegiaoUF,
    // 'SP' ou 'DEMAIS' - define qual composicao Hero se aplica
    RegiaoHero,
    If(RegiaoHero = 'SP', 'Cat 3 = Fatiados', 'Cat 3 = Manteiga') AS RegiaoHeroDescricao,
    Lower(RegiaoCoordenadorEmail) AS RegiaoCoordenadorEmail
RESIDENT SRC_REGIAO;

// Text() nos dois lados do mapa. Chave texto x chave numerica nao casa e o
// ApplyMap devolve o padrao sem erro - ver o guarda no fim desta aba.
MAP_REGIAO_HERO_FINAL: MAPPING LOAD Text(RegiaoID), RegiaoHero RESIDENT DIM_REGIAO;
MAP_REGIAO_NOME:       MAPPING LOAD Text(RegiaoID), RegiaoNome RESIDENT DIM_REGIAO;

// -----------------------------------------------------------------------------
// DIM_EXECUTIVO
// -----------------------------------------------------------------------------
DIM_EXECUTIVO:
LOAD
    AutoNumberHash128(ExecutivoID) AS %ChaveExecutivo,
    ExecutivoID,
    ExecutivoNome,
    Lower(ExecutivoEmail)          AS ExecutivoEmail,
    ExecutivoCargo,
    ApplyMap('MAP_REGIAO_NOME', Text(RegiaoID), 'Nao informada') AS ExecutivoRegiaoNome
RESIDENT SRC_EXECUTIVO;

DROP TABLE SRC_EXECUTIVO;

// -----------------------------------------------------------------------------
// DIM_DISTRIBUIDOR
// -----------------------------------------------------------------------------
DIM_DISTRIBUIDOR:
LOAD
    AutoNumberHash128(DistribuidorID)                    AS %ChaveDistribuidor,
    DistribuidorID,
    DistribuidorCNPJ,
    Left(DistribuidorCNPJ, 2) & '.' & Mid(DistribuidorCNPJ, 3, 3) & '.'
        & Mid(DistribuidorCNPJ, 6, 3) & '/' & Mid(DistribuidorCNPJ, 9, 4)
        & '-' & Right(DistribuidorCNPJ, 2)               AS DistribuidorCNPJFormatado,
    DistribuidorNome,
    AutoNumberHash128(RegiaoID)                          AS %ChaveRegiao,
    AutoNumberHash128(ExecutivoID)                       AS %ChaveExecutivo,
    DistribuidorStatus,
    DistribuidorDataInicioPPT,
    Lower(DistribuidorEmailPortal)                       AS DistribuidorEmailPortal,
    // Elegibilidade ao PPT: precisa estar ativo e ter iniciado o programa
    If(DistribuidorStatus = 'Ativo', 1, 0)               AS FlagDistribuidorElegivel,
    // Composicao Hero herdada da regiao - fica no distribuidor porque e ele
    // quem determina qual regra vale para as vendas dele
    ApplyMap('MAP_REGIAO_HERO_FINAL', Text(RegiaoID), 'DEMAIS') AS DistribuidorRegiaoHero
RESIDENT SRC_DISTRIBUIDOR;

// Mapas para derivar a chave Hero na tabela fato
MAP_DIST_REGIAOHERO: MAPPING LOAD DistribuidorID, DistribuidorRegiaoHero RESIDENT DIM_DISTRIBUIDOR;
MAP_DIST_NOME:       MAPPING LOAD DistribuidorID, DistribuidorNome       RESIDENT DIM_DISTRIBUIDOR;


/* =============================================================================
   GUARDA DE MAPA
   -----------------------------------------------------------------------------
   ApplyMap(mapa, chave, PADRAO) e uma falha silenciosa por construcao: quando a
   chave nao casa, ele devolve o padrao e a carga segue limpa. Foi exatamente
   assim que a composicao Hero de Sao Paulo sumiu - todo distribuidor virou
   'DEMAIS' e nenhum erro apareceu no log.

   O teste usa um SENTINELA no lugar do padrao. Se ele voltar, a chave nao casou
   e a carga aborta: numero errado em premiacao e pior que carga que nao roda.
   Ver docs/07-qa-checklist.md QA-06C.
   ============================================================================= */
TMP_QA_MAPA_REGIAO:
LOAD Count(DistribuidorID) AS QtdSemRegiao
RESIDENT SRC_DISTRIBUIDOR
WHERE ApplyMap('MAP_REGIAO_HERO_FINAL', Text(RegiaoID), '@@SEM_MATCH@@') = '@@SEM_MATCH@@';

LET vQtdSemRegiao = Num(Alt(Peek('QtdSemRegiao', 0, 'TMP_QA_MAPA_REGIAO'), 0), '0');
DROP TABLE TMP_QA_MAPA_REGIAO;

IF $(vQtdSemRegiao) > 0 THEN
    TRACE !! FALHA CRITICA: $(vQtdSemRegiao) distribuidores com RegiaoID que nao casa com DIM_REGIAO.;
    TRACE !! A composicao Hero cairia para DEMAIS em silencio. Verifique o TIPO da chave RegiaoID.;
    EXIT SCRIPT;
END IF;

/* A mesma divergencia de tipo quebrava a ligacao do modelo estrela:
   %ChaveRegiao = AutoNumberHash128(RegiaoID) era calculada sobre um NUMERO em
   DIM_REGIAO e sobre um TEXTO em DIM_DISTRIBUIDOR. Hashes diferentes, chave
   orfa, e a regiao simplesmente nao associava ao distribuidor.
   Integridade referencial de chave gerada tem que ser testada, nao presumida. */
MAP_QA_CHAVE_REGIAO:
MAPPING LOAD %ChaveRegiao, 1 RESIDENT DIM_REGIAO;

TMP_QA_LINK_REGIAO:
LOAD Count(DistribuidorID) AS QtdOrfaos
RESIDENT DIM_DISTRIBUIDOR
WHERE ApplyMap('MAP_QA_CHAVE_REGIAO', %ChaveRegiao, 0) = 0;

LET vQtdOrfaos = Num(Alt(Peek('QtdOrfaos', 0, 'TMP_QA_LINK_REGIAO'), 0), '0');
DROP TABLE TMP_QA_LINK_REGIAO;

IF $(vQtdOrfaos) > 0 THEN
    TRACE !! FALHA CRITICA: $(vQtdOrfaos) distribuidores com %ChaveRegiao orfa em DIM_REGIAO.;
    TRACE !! A regiao nao associa ao distribuidor. Verifique o TIPO do campo antes do AutoNumberHash128.;
    EXIT SCRIPT;
END IF;

TRACE >> Guarda de mapa OK: composicao Hero e chave de regiao resolvidas para todos os distribuidores.;

DROP TABLE SRC_REGIAO;

DROP TABLE SRC_DISTRIBUIDOR;

// -----------------------------------------------------------------------------
// DIM_PDV
// A chave de negocio da positivacao e o CNPJ - 14 digitos, sem mascara.
// Qualquer sujeira aqui infla ou desinfla o KPI que paga o distribuidor.
// -----------------------------------------------------------------------------
DIM_PDV:
LOAD
    AutoNumberHash128(CNPJ)                              AS %ChavePDV,
    CNPJ,
    Left(CNPJ, 2) & '.' & Mid(CNPJ, 3, 3) & '.' & Mid(CNPJ, 6, 3)
        & '/' & Mid(CNPJ, 9, 4) & '-' & Right(CNPJ, 2)   AS CNPJFormatado,
    PDVNome,
    PDVFantasia,
    PDVCanal,
    PDVCidade,
    PDVUF,
    PDVLatitude,
    PDVLongitude,
    PDVDataCadastro
RESIDENT SRC_PDV
// Len = 14 descarta CNPJ sujo; NOT Exists(CNPJ) garante 1 linha por CNPJ.
// Sem a deduplicacao, um PDV cadastrado duas vezes conta duas positivacoes.
WHERE Len(Trim(CNPJ)) = 14 AND NOT Exists(CNPJ);

// Log de qualidade - ilha proposital, consumida no painel de auditoria.
// Criada sempre com uma linha semente para que os CONCATENATE das abas
// seguintes nunca falhem quando nao houver rejeicao.
QA_REJEITADOS:
LOAD * INLINE [
QA_Tabela, QA_Motivo, QA_Valor, QA_Ocorrencias
CARGA, Execucao iniciada sem rejeicoes, -, 0
];

CONCATENATE (QA_REJEITADOS)
LOAD
    'DIM_PDV'                                            AS QA_Tabela,
    'CNPJ invalido (tamanho diferente de 14)'            AS QA_Motivo,
    CNPJ                                                 AS QA_Valor,
    Count(CNPJ)                                          AS QA_Ocorrencias
RESIDENT SRC_PDV
WHERE Len(Trim(CNPJ)) <> 14
GROUP BY CNPJ;

DROP TABLE SRC_PDV;

MAP_PDV_FANTASIA:    MAPPING LOAD CNPJ, PDVFantasia   RESIDENT DIM_PDV;
MAP_PDV_CANAL:       MAPPING LOAD CNPJ, PDVCanal      RESIDENT DIM_PDV;
MAP_PDV_CIDADE:      MAPPING LOAD CNPJ, PDVCidade     RESIDENT DIM_PDV;
MAP_PDVKEY_CANAL:    MAPPING LOAD %ChavePDV, PDVCanal RESIDENT DIM_PDV;

// -----------------------------------------------------------------------------
// DIM_PRODUTO
// -----------------------------------------------------------------------------
DIM_PRODUTO:
LOAD
    AutoNumberHash128(CodProduto)                        AS %ChaveProduto,
    CodProduto,
    ProdutoDescricao,
    ProdutoCategoria,
    // Normalizada: e a chave que casa com a composicao Hero
    Capitalize(Trim(ProdutoSubcategoria))                AS ProdutoSubcategoria,
    ProdutoGramatura,
    ProdutoGramatura & 'g'                               AS ProdutoGramaturaLabel,
    ProdutoUnidCaixa,
    ProdutoPesoKg,
    ProdutoPesoCaixaKg,
    ProdutoMarca,
    FlagProdutoAtivo
RESIDENT SRC_PRODUTO;

MAP_PRODUTO_SUBCAT: MAPPING LOAD CodProduto, Capitalize(Trim(ProdutoSubcategoria)) RESIDENT SRC_PRODUTO;
MAP_PRODUTO_PESO:   MAPPING LOAD CodProduto, ProdutoPesoCaixaKg                    RESIDENT SRC_PRODUTO;
MAP_PRODUTO_DESC:   MAPPING LOAD CodProduto, ProdutoDescricao                      RESIDENT SRC_PRODUTO;
MAP_PRODKEY_COD:    MAPPING LOAD AutoNumberHash128(CodProduto), CodProduto          RESIDENT SRC_PRODUTO;

DROP TABLE SRC_PRODUTO;

TRACE >> Dimensoes carregadas;
