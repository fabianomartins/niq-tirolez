# ---------------------------------------------------------------------------
# Qlik Sense Cloud
# ---------------------------------------------------------------------------
# Deixe NEXT_PUBLIC_QLIK_MOCK=true para rodar sem tenant (dados sinteticos).
NEXT_PUBLIC_QLIK_MOCK=true

NEXT_PUBLIC_QLIK_TENANT=seu-tenant.us.qlikcloud.com
NEXT_PUBLIC_QLIK_APP_ID=00000000-0000-0000-0000-000000000000

# Web Integration ID criado em Administracao > Integracoes de conteudo web
NEXT_PUBLIC_QLIK_WEB_INTEGRATION_ID=

# OAuth2 (Authorization Code + PKCE). O client secret NUNCA vai para o browser:
# fica apenas nas variaveis sem prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_QLIK_OAUTH_CLIENT_ID=
QLIK_OAUTH_CLIENT_SECRET=
QLIK_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Chave usada para assinar o cookie de sessao do mashup
SESSION_SECRET=troque-isto-em-producao
